<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aqorin.Phone.App.ViewModels"
             xmlns:views="using:Aqorin.Phone.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="560"
             x:Class="Aqorin.Phone.App.Views.ActiveCallView"
             x:DataType="vm:DialerViewModel"
             x:CompileBindings="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12,18" HorizontalAlignment="Stretch" MinWidth="0">
            <Border Classes="phoneShell" HorizontalAlignment="Stretch" MinWidth="0">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel>
                            <TextBlock Classes="heroTitle" Text="Active Call" />
                            <TextBlock Classes="caption" Text="{Binding DisplayStatusMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="pill" Background="{Binding State, Converter={x:Static views:Converters.CallStateBrush}}">
                            <TextBlock Text="{Binding StateText}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Border Classes="avatarLarge">
                            <Viewbox Width="66" Height="66" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <Ellipse Width="24" Height="24" Canvas.Left="20" Canvas.Top="7"
                                             Stroke="{DynamicResource IconForegroundBrush}" StrokeThickness="3.1" />
                                    <Path Stroke="{DynamicResource IconForegroundBrush}" StrokeThickness="3.1"
                                          StrokeLineCap="Round"
                                          Data="M12,51 C12,37 23,31 32,31 C41,31 52,37 52,51" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{Binding DisplayRemoteParty}" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="340" IsVisible="{Binding IsInCall}" />
                        <TextBlock Text="{Binding DisplayStatusMessage}" Classes="caption" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                        <TextBlock Text="{Binding Duration}" FontSize="22" HorizontalAlignment="Center" IsVisible="{Binding IsActive}" />
                        <TextBlock Text="{Binding Detail}" Classes="caption" IsVisible="{Binding HasDetail}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch" MinWidth="0">
                        <Button Grid.Column="0" Classes="callControl" HorizontalAlignment="Center"
                                Command="{Binding ToggleMuteCommand}" IsEnabled="{Binding IsInCall}">
                            <TextBlock Classes="controlText" Text="{Binding MuteButtonText}" />
                        </Button>
                        <Button Grid.Column="1" Classes="callControl" HorizontalAlignment="Center"
                                Command="{Binding ToggleHoldCommand}" IsEnabled="{Binding IsActive}">
                            <TextBlock Classes="controlText" Text="{Binding HoldButtonText}" />
                        </Button>
                        <Button Grid.Column="2" Classes="callControl" Classes.activeControl="{Binding IsSpeakerEnabled}"
                                HorizontalAlignment="Center" Command="{Binding ToggleSpeakerCommand}" IsEnabled="{Binding IsInCall}">
                            <TextBlock Classes="controlText" Text="{Binding SpeakerButtonText}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="*,10,*" HorizontalAlignment="Stretch" MinWidth="0">
                        <Grid Grid.Column="0" IsVisible="{Binding IsIncoming}" Height="44">
                            <Button Classes="success" Command="{Binding AnswerCommand}" MinWidth="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <TextBlock Text="Answer" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       IsHitTestVisible="False" ZIndex="1" />
                        </Grid>
                        <Grid Grid.Column="2" IsVisible="{Binding IsIncoming}" Height="44">
                            <Button Classes="danger" Command="{Binding RejectCommand}" MinWidth="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <TextBlock Text="Reject" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       IsHitTestVisible="False" ZIndex="1" />
                        </Grid>
                        <Grid Grid.ColumnSpan="3" IsVisible="{Binding ShowHangup}" Width="210" Height="52"
                              HorizontalAlignment="Center">
                            <Button Classes="hangupWide" Command="{Binding HangupCommand}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            <TextBlock Text="Hang up" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       IsHitTestVisible="False" ZIndex="1" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
