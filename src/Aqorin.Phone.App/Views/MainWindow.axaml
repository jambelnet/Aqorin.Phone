<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aqorin.Phone.App.ViewModels"
        xmlns:views="using:Aqorin.Phone.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="680"
        x:Class="Aqorin.Phone.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/aqorin-phone.ico"
        Width="1120" Height="680"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="18,0" MinHeight="52" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource PanelStrokeBrush}"
                Background="{DynamicResource PanelSurfaceBrush}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto,*" ColumnSpacing="16">
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding StatusIsGood, Converter={x:Static views:Converters.GoodBadBrush}}" />
                        <TextBlock Text="{Binding StatusBarText}" Classes="caption" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding AudioWarning}" Classes="error" IsVisible="{Binding HasAudioWarning}" />
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="1" Classes="themeToggle"
                        Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToolTip}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThemeIcon}" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Dialer">
                <views:DialerView DataContext="{Binding Dialer}" />
            </TabItem>
            <TabItem Header="Active Call">
                <views:ActiveCallView DataContext="{Binding Dialer}" />
            </TabItem>
            <TabItem Header="Contacts">
                <views:ContactsView DataContext="{Binding Dialer}" />
            </TabItem>
            <TabItem Header="Recents">
                <views:RecentsView DataContext="{Binding Dialer}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:AccountView DataContext="{Binding Account}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
