<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aqorin.Phone.App.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="AppSurfaceBrush" Color="#EEF4FB" />
                <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FAFCFF" />
                <SolidColorBrush x:Key="PanelStrokeBrush" Color="#D9E4F0" />
                <SolidColorBrush x:Key="SubtleButtonBrush" Color="#EEF3F8" />
                <SolidColorBrush x:Key="IconForegroundBrush" Color="#111827" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0B121A" />
                <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#111B26" />
                <SolidColorBrush x:Key="PanelStrokeBrush" Color="#263747" />
                <SolidColorBrush x:Key="SubtleButtonBrush" Color="#1F2B38" />
                <SolidColorBrush x:Key="IconForegroundBrush" Color="#F8FAFC" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Color x:Key="SystemAccentColor">#DC2626</Color>
        <Color x:Key="SystemAccentColorDark1">#B91C1C</Color>
        <Color x:Key="SystemAccentColorDark2">#991B1B</Color>
        <Color x:Key="SystemAccentColorDark3">#7F1D1D</Color>
        <Color x:Key="SystemAccentColorLight1">#EF4444</Color>
        <Color x:Key="SystemAccentColorLight2">#F87171</Color>
        <Color x:Key="SystemAccentColorLight3">#FCA5A5</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#991B1B" />
        <SolidColorBrush x:Key="GoodBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#D97706" />
        <SolidColorBrush x:Key="BadBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="NeutralBrush" Color="#8A8F98" />
        <SolidColorBrush x:Key="AqorinTealBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="AqorinBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#F7FAFD" Opacity="0.92" />
        <SolidColorBrush x:Key="SoftPanelDarkBrush" Color="#111923" Opacity="0.94" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Tab strip: header text starts at the same x as the card content (24 px) -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
        </Style>

        <!-- Typography -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.heroTitle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.digit">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.keyLetters">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.controlText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Menlo,Consolas,monospace" />
        </Style>

        <!-- Cards / sections -->
        <Style Selector="Border.phoneShell">
            <Setter Property="Width" Value="430" />
            <Setter Property="MinHeight" Value="590" />
            <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
        </Style>
        <Style Selector="Border.phonePanel">
            <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="Border.sidePanel">
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.footerPanel">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.appHeader">
            <Setter Property="Padding" Value="24,18,24,14" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.appIcon">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource AqorinTealBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.avatarLarge">
            <Setter Property="Width" Value="122" />
            <Setter Property="Height" Value="122" />
            <Setter Property="CornerRadius" Value="61" />
            <Setter Property="BorderBrush" Value="{StaticResource AqorinBlueBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.avatarSmall">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.segmented">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Border.segmentSelected">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource AqorinBlueBrush}" />
        </Style>
        <Style Selector="Button.segmentButton">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.segmentButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AqorinBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.segmentChip">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.segmentChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.segmentChipFill">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="13,0" />
        </Style>
        <Style Selector="Border.segmentChipFill TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.segmentSelected TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.callDirectionBadge">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Grid.listRow">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.dialPadButton">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="36" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SubtleButtonBrush}" />
        </Style>
        <Style Selector="Button.callControl">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="82" />
            <Setter Property="CornerRadius" Value="41" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SubtleButtonBrush}" />
        </Style>
        <Style Selector="Button.activeControl">
            <Setter Property="Background" Value="{StaticResource AqorinBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.roundUtility">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleButtonBrush}" />
        </Style>
        <Style Selector="Button.contactAction">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource SubtleButtonBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.dangerText">
            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
        </Style>
        <Style Selector="Button.themeToggle">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SubtleButtonBrush}" />
        </Style>
        <Style Selector="Button.callRound">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="82" />
            <Setter Property="CornerRadius" Value="41" />
            <Setter Property="Background" Value="{StaticResource GoodBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.hangupWide">
            <Setter Property="Width" Value="210" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Background" Value="{StaticResource BadBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource BadBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource BadBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="{StaticResource GoodBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </Application.Styles>
</Application>
